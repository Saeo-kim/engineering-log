# Copy to .env for local use. Never commit .env.
APP_USERNAME=your-username
APP_PASSWORD=use-a-password-of-at-least-12-characters
# SQLite file. Put it on a persistent volume in production.
DATABASE_FILE=./data/engineering-log.db
PORT=3000
# auto = Secure cookie when served over HTTPS (default). Set true/false to force.
COOKIE_SECURE=auto
# Set to 1 only when running behind a reverse proxy you control (uses X-Forwarded-For for rate limiting).
TRUST_PROXY=0
